pkgname=qemu-qmx
_qmxver=0.9.0-beta.1
_qemuversion=11.1.50
pkgver=${_qemuversion}.qmx0.9.0beta1
pkgrel=1
pkgdesc='QEMU x86 system emulator with QMX machine configuration support'
arch=('x86_64')
url='https://github.com/StochasticEagle/qemu-qmx'
license=('GPL-2.0-or-later')
provides=('qemu-system-x86')
conflicts=('qemu-system-x86')
replaces=('qemu-system-x86')
depends=('glib2' 'pixman' 'zlib' 'libslirp' 'sdl2-compat' 'qemu-common' 'qemu-system-x86-firmware')
makedepends=('git' 'gcc' 'meson' 'ninja' 'python' 'pkgconf')
source=("qemu-qmx::git+https://github.com/StochasticEagle/qemu-qmx.git#tag=qmx-v${_qmxver}")
sha256sums=('SKIP')

build() {
  cd "$srcdir/qemu-qmx"
  rm -rf build-package
  mkdir build-package
  cd build-package
  ../configure \
    --prefix=/usr \
    --libdir=/usr/lib \
    --target-list=i386-softmmu,x86_64-softmmu \
    --without-default-features \
    --enable-system \
    --enable-kvm \
    --enable-tcg \
    --enable-sdl \
    --enable-slirp \
    --audio-drv-list=sdl \
    --disable-docs \
    --disable-tools \
    --disable-guest-agent
  ninja
}

check() {
  cd "$srcdir/qemu-qmx"
  python tests/qmx/test-qmx-parser.py build-package/qemu-system-x86_64
  python tests/qmx/test-qmx-integration.py build-package/qemu-system-x86_64
}

package() {
  cd "$srcdir/qemu-qmx"

  install -Dm755 build-package/qemu-system-x86_64 \
    "$pkgdir/usr/bin/qemu-system-x86_64"
  install -Dm755 build-package/qemu-system-i386 \
    "$pkgdir/usr/bin/qemu-system-i386"

  install -Dm644 QMX_VERSION \
    "$pkgdir/usr/share/doc/qemu-qmx/QMX_VERSION"
  install -Dm644 docs/QMX_Format_Specification_v0.2.md \
    "$pkgdir/usr/share/doc/qemu-qmx/QMX_Format_Specification_v0.2.md"
  install -Dm644 docs/QMX_Minimum_Implementation_Requirements_v0.1.md \
    "$pkgdir/usr/share/doc/qemu-qmx/QMX_Minimum_Implementation_Requirements_v0.1.md"
  install -Dm644 docs/releases/QMX_0.9.0-beta.1.md \
    "$pkgdir/usr/share/doc/qemu-qmx/QMX_0.9.0-beta.1.md"
  install -Dm644 COPYING \
    "$pkgdir/usr/share/licenses/qemu-qmx/COPYING"
}
